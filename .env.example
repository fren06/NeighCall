# Copy this file to `.env.local` and fill in the values.
# Supabase dashboard → green "Connect" button (top bar) shows both.
#
# Only use the *publishable* key here. Never put the secret / service_role
# key in this app or in git — it bypasses every security rule.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
